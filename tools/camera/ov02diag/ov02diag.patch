+
+/*
+ * DIAG: the sensor's avdd/dvdd rails are not described by the board and are not
+ * named anywhere in firmware, so they have to be found by trial.  Doing that in
+ * the device tree costs a kernel rebuild per guess; instead attach the supply
+ * properties to the sensor's DT node at load time, so a rail can be tried by
+ * reloading this module.
+ *
+ *   insmod ov02diag.ko avdd=vreg_l7b_2p8 dvdd=vreg_l1c_1p2
+ */
+static char *avdd_rail;
+module_param_named(avdd, avdd_rail, charp, 0444);
+MODULE_PARM_DESC(avdd, "regulator-name to attach as avdd-supply");
+
+static char *dvdd_rail;
+module_param_named(dvdd, dvdd_rail, charp, 0444);
+MODULE_PARM_DESC(dvdd, "regulator-name to attach as dvdd-supply");
+
+static struct device_node *ov02diag_find_rail(const char *want)
+{
+	struct device_node *np = NULL;
+	const char *name;
+
+	while ((np = of_find_node_with_property(np, "regulator-name"))) {
+		if (!of_property_read_string(np, "regulator-name", &name) &&
+		    !strcmp(name, want))
+			return np;
+	}
+	return NULL;
+}
+
+static void ov02diag_attach(struct device *dev, const char *prop, const char *rail)
+{
+	struct device_node *rnp;
+	struct property *pp, *existing;
+	__be32 ph;
+
+	if (!rail || !*rail || !dev->of_node)
+		return;
+
+	rnp = ov02diag_find_rail(rail);
+	if (!rnp) {
+		dev_err(dev, "DIAG: no regulator named %s\n", rail);
+		return;
+	}
+	if (!rnp->phandle) {
+		dev_err(dev, "DIAG: %s has no phandle\n", rail);
+		of_node_put(rnp);
+		return;
+	}
+
+	ph = cpu_to_be32(rnp->phandle);
+
+	pp = kzalloc(sizeof(*pp), GFP_KERNEL);
+	if (!pp) {
+		of_node_put(rnp);
+		return;
+	}
+	pp->name = kstrdup(prop, GFP_KERNEL);
+	pp->length = sizeof(ph);
+	pp->value = kmemdup(&ph, sizeof(ph), GFP_KERNEL);
+	if (!pp->name || !pp->value) {
+		kfree(pp->name);
+		kfree(pp->value);
+		kfree(pp);
+		of_node_put(rnp);
+		return;
+	}
+
+	/*
+	 * of_update_property is not exported, and the property survives a module
+	 * unload, so on a reload patch the existing phandle in place instead.
+	 * That is what makes sweeping rails possible without rebooting.
+	 */
+	existing = of_find_property(dev->of_node, prop, NULL);
+	if (existing && existing->length == sizeof(ph)) {
+		*(__be32 *)existing->value = ph;
+		dev_info(dev, "DIAG: %s -> %s (phandle 0x%x, updated)\n", prop,
+			 rail, rnp->phandle);
+		kfree(pp->name);
+		kfree(pp->value);
+		kfree(pp);
+	} else if (of_add_property(dev->of_node, pp)) {
+		dev_err(dev, "DIAG: failed to attach %s = %s\n", prop, rail);
+	} else {
+		dev_info(dev, "DIAG: %s -> %s (phandle 0x%x, added)\n", prop,
+			 rail, rnp->phandle);
+	}
+	of_node_put(rnp);
+}
