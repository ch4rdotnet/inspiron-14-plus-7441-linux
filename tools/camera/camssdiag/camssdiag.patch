 };
 
-module_platform_driver(qcom_camss_driver);
+static int __init camss_diag_init(void)
+{
+	camss_diag_repoint();
+	return platform_driver_register(&qcom_camss_driver);
+}
+module_init(camss_diag_init);
+
+static void __exit camss_diag_exit(void)
+{
+	platform_driver_unregister(&qcom_camss_driver);
+}
+module_exit(camss_diag_exit);
 
