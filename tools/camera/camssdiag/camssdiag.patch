+/*
+ * DIAG: which CSIPHY the board routes the sensor to is not documented anywhere,
+ * and the DT graph link is immutable, so trying each one would otherwise cost a
+ * kernel rebuild apiece.  Re-point csiphy0's registers, clocks and interrupt at
+ * another PHY instead: the media graph still says msm_csiphy0, but the hardware
+ * driven is whichever this selects.
+ *
+ *   insmod camssdiag.ko phy=1
+ */
+static int phy;
+module_param(phy, int, 0444);
+MODULE_PARM_DESC(phy, "physical CSIPHY to drive from the csiphy0 subdev (0,1,2,4)");
+
+static void camss_diag_repoint(void)
+{
+	struct camss_subdev_resources *a, *b;
+	char *tmp;
+	int i;
+
+	/*
+	 * Swap, rather than overwrite: every csiphy subdev maps its own register
+	 * window by name, so simply pointing csiphy0 at csiphy1's window makes
+	 * two subdevs claim it and the whole of camss fails to probe.  Swapping
+	 * keeps each window claimed exactly once.
+	 *
+	 * .csiphy.id is deliberately left alone - camss matches DT port@N to the
+	 * subdev with that id, so changing it unbinds the sensor from the graph.
+	 * Only the hardware behind the subdev moves.
+	 *
+	 * phy is an index into the table, which is csiphy0, 1, 2, 4.
+	 */
+	if (phy <= 0 || phy >= ARRAY_SIZE(csiphy_res_x1e80100))
+		return;
+
+	a = &csiphy_res_x1e80100[0];
+	b = &csiphy_res_x1e80100[phy];
+
+	for (i = 0; i < 2; i++) {
+		tmp = a->clock[i]; a->clock[i] = b->clock[i]; b->clock[i] = tmp;
+	}
+	tmp = a->reg[0];       a->reg[0] = b->reg[0];             b->reg[0] = tmp;
+	tmp = a->interrupt[0]; a->interrupt[0] = b->interrupt[0]; b->interrupt[0] = tmp;
+
+	pr_info("camssdiag: csiphy0 subdev now drives %s (swapped with index %d)\n",
+		a->reg[0], phy);
+}
+
 static const struct of_device_id camss_dt_match[] = {
 	{ .compatible = "qcom,msm8916-camss", .data = &msm8916_resources },
 	{ .compatible = "qcom,msm8939-camss", .data = &msm8939_resources },
@@ -5387,7 +5458,18 @@
