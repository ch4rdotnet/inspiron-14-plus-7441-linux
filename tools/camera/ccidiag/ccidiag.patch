+
+/*
+ * DIAG: the DSDT lists three SPIs for the camera block but does not say which
+ * belongs to which aperture.  Rather than guess the permutation one kernel
+ * build at a time, map every candidate onto the GIC ourselves and see which one
+ * the reset pulse actually raises.
+ */
+static const u32 cci_diag_spis[] = { 271, 459, 460, 461, 462, 270, 272 };
+#define CCI_DIAG_N ARRAY_SIZE(cci_diag_spis)
+static int cci_diag_virq[CCI_DIAG_N];
+static atomic_t cci_diag_hits[CCI_DIAG_N];
+
+static irqreturn_t cci_diag_isr(int irq, void *data)
+{
+	atomic_inc((atomic_t *)data);
+	return IRQ_NONE;	/* let the real handler, if any, also see it */
+}
+
+static void cci_diag_hook(struct cci *cci)
+{
+	struct device_node *par;
+	struct irq_fwspec fw;
+	int i;
+
+	par = of_irq_find_parent(cci->dev->of_node);
+	if (!par) {
+		dev_err(cci->dev, "DIAG: no interrupt parent\n");
+		return;
+	}
+
+	for (i = 0; i < CCI_DIAG_N; i++) {
+		memset(&fw, 0, sizeof(fw));
+		fw.fwnode = of_fwnode_handle(par);
+		fw.param_count = 3;
+		fw.param[0] = 0;			/* GIC_SPI */
+		fw.param[1] = cci_diag_spis[i];
+		fw.param[2] = IRQ_TYPE_EDGE_RISING;
+
+		cci_diag_virq[i] = irq_create_fwspec_mapping(&fw);
+		if (cci_diag_virq[i] <= 0) {
+			cci_diag_virq[i] = 0;
+			continue;
+		}
+		atomic_set(&cci_diag_hits[i], 0);
+		if (request_irq(cci_diag_virq[i], cci_diag_isr, IRQF_SHARED,
+				"ccidiag", &cci_diag_hits[i])) {
+			dev_info(cci->dev, "DIAG: SPI %u already claimed, skipping\n",
+				 cci_diag_spis[i]);
+			cci_diag_virq[i] = 0;
+		}
+	}
+	of_node_put(par);
+}
+
+static void cci_diag_report(struct cci *cci)
+{
+	int i;
+
+	for (i = 0; i < CCI_DIAG_N; i++) {
+		if (!cci_diag_virq[i])
+			continue;
+		if (atomic_read(&cci_diag_hits[i]))
+			dev_err(cci->dev, "DIAG: *** SPI %u (virq %d) FIRED %d time(s) ***\n",
+				cci_diag_spis[i], cci_diag_virq[i],
+				atomic_read(&cci_diag_hits[i]));
+		free_irq(cci_diag_virq[i], &cci_diag_hits[i]);
+		cci_diag_virq[i] = 0;
+	}
+}
+
 static int cci_reset(struct cci *cci)
 {
 	/*
 	 * we reset the whole controller, here and for implicity use
 	 * master[0].xxx for waiting on it.
 	 */
+	u32 ver, st;
+	int i;
+
+	ver = readl(cci->base + CCI_HW_VERSION);
+	dev_info(cci->dev, "DIAG: HW_VERSION = 0x%08x  (irq=%d)\n", ver, cci->irq);
+	if (ver == 0 || ver == 0xffffffff) {
+		dev_err(cci->dev, "DIAG: version register is 0x%08x - this is not a live CCI aperture\n",
+			ver);
+		return -ENODEV;
+	}
+
 	reinit_completion(&cci->master[0].irq_complete);
 	writel(CCI_RESET_CMD_MASK, cci->base + CCI_RESET_CMD);
 
 	if (!wait_for_completion_timeout(&cci->master[0].irq_complete,
 					 CCI_TIMEOUT)) {
-		dev_err(cci->dev, "CCI reset timeout\n");
+		/*
+		 * No interrupt.  Poll the status register: if RST_DONE_ACK is
+		 * set the controller did reset and only the IRQ routing is
+		 * wrong, which is a DT problem rather than a dead aperture.
+		 */
+		for (i = 0; i < 100; i++) {
+			st = readl(cci->base + CCI_IRQ_STATUS_0);
+			if (st & CCI_IRQ_STATUS_0_RST_DONE_ACK)
+				break;
+			usleep_range(1000, 2000);
+		}
+		st = readl(cci->base + CCI_IRQ_STATUS_0);
+		if (st & CCI_IRQ_STATUS_0_RST_DONE_ACK) {
+			dev_err(cci->dev, "DIAG: no IRQ, but RST_DONE_ACK IS set (status 0x%08x) -> registers good, INTERRUPT IS WRONG\n",
+				st);
+			writel(0x1, cci->base + CCI_IRQ_GLOBAL_CLEAR_CMD);
+			writel(0x0, cci->base + CCI_IRQ_GLOBAL_CLEAR_CMD);
+			return -ETIMEDOUT;
+		}
+		dev_err(cci->dev, "DIAG: no IRQ and RST_DONE_ACK not set (status 0x%08x) -> reset never completed\n",
+			st);
 		return -ETIMEDOUT;
 	}
 
+	dev_info(cci->dev, "DIAG: *** RESET COMPLETED VIA INTERRUPT - CCI IS UP ***\n");
 	return 0;
 }
 
